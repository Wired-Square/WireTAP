{
  "cases": [
    {
      "name": "Empty values",
      "input": {
        "values": [],
        "binCount": 10
      },
      "expected": []
    },
    {
      "name": "Zero bins",
      "input": {
        "values": [
          "1",
          "2",
          "3"
        ],
        "binCount": 0
      },
      "expected": []
    },
    {
      "name": "Negative bins",
      "input": {
        "values": [
          "1",
          "2",
          "3"
        ],
        "binCount": -1
      },
      "expected": []
    },
    {
      "name": "One distinct value: one bin [v, v+1) whatever the bin count",
      "input": {
        "values": [
          "4",
          "4",
          "4"
        ],
        "binCount": 10
      },
      "expected": [
        {
          "min": 4,
          "max": 5,
          "centre": 4,
          "count": 3
        }
      ]
    },
    {
