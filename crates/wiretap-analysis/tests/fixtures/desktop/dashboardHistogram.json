    {
      "name": "More bins than values",
      "input": {
        "values": [
          "1",
          "2"
        ],
        "binCount": 5
      },
      "expected": [
        {
          "min": 1,
          "max": 1.2,
          "centre": 1.1,
          "count": 1
        },
        {
          "min": 1.2,
