        {
          "min": 1.8,
          "max": 2,
          "centre": 1.9,
          "count": 1
        }
      ]
    },
    {
      "name": "A fractional bin count throws",
      "input": {
        "values": [
          "0",
          "1",
          "2",
          "3"
        ],
        "binCount": 2.5
      },
      "expected": {
        "threw": "TypeError: Cannot read properties of undefined (reading 'count')"
      }
    },
    {
      "name": "A NaN value throws (its bin index is NaN)",
      "input": {
        "values": [
          "1",
          "NaN",
          "3"
        ],
        "binCount": 2
      },
      "expected": {
        "threw": "TypeError: Cannot read properties of undefined (reading 'count')"
      }
    },
    {
      "name": "Infinity gives no bins",
      "input": {
        "values": [
          "1",
          "Infinity"
        ],
        "binCount": 2
      },
      "expected": []
