    {
      "name": "a pushed queue replaces the view and marks its sessions; an older one is ignored",
      "input": "revision 2, then revision 1",
      "expected": {
        "error": null,
        "invoked": [],
        "queue": [
          "tx-1",
          "tx-2"
        ],
        "queueRevision": 2,
        "activeGroups": [
          "g"
        ],
        "queuedMarks": {
          "a": true,
          "b": false
        }
      }
