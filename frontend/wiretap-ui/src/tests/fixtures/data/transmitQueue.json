                        0,
                        0,
                        0,
                        0,
                        0,
                        0
                      ],
                      "bus": 0,
                      "is_extended": false,
                      "is_fd": false,
                      "is_brs": false,
                      "is_rtr": false
                    }
                  },
                  "interval_ms": 1000,
                  "group": null
                }
              ]
            }
          }
        ],
        "queue": [],
        "queueRevision": -1,
        "activeGroups": [],
        "queuedMarks": {
          "a": false,
          "b": false
        }
      }
    },
