      "expected": {
        "error": "[\"a\",\"b\"]",
        "invoked": [],
        "queue": [
          "1",
          "2",
          "3",
          "4"
        ],
        "queueRevision": 1,
        "activeGroups": [],
        "queuedMarks": {
          "a": true,
          "b": false
        }
      }
