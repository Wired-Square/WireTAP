      "input": "defaults",
      "expected": {
        "error": null,
        "invoked": [
          {
            "cmd": "transmit_queue_add",
            "args": {
              "rows": [
                {
                  "session_id": "a",
                  "profile_id": "profile_a",
                  "profile_name": "name_a",
                  "payload": {
                    "kind": "can",
