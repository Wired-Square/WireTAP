    {
      "name": "falsy directories take the default dirs",
      "input": {
        "raw": {
          "decoder_dir": "",
          "dump_dir": "/d"
        },
        "dirs": {
          "decoders": "/dec",
          "dumps": "/dmp",
          "reports": "/rep"
        }
      },
      "expected": {
        "decoder_dir": "/dec",
        "dump_dir": "/d",
        "report_dir": "/rep"
      }
    },
    {
      "name": "legacy and unknown keys are dropped",
      "input": {
        "raw": {
          "enable_file_logging": true,
          "log_level": "off",
          "capture_storage": "x",
          "clear_buffers_on_start": false
        }
      },
      "expected": {}
    },
    {
      "name": "out-of-range numbers are not clamped",
      "input": {
        "raw": {
          "query_result_limit": 5,
          "smp_port": 0,
          "mcp_server_port": 80,
          "graph_buffer_size": 1000000000,
          "modbus_max_register_errors": -1
        }
      },
      "expected": {
        "query_result_limit": 5,
        "graph_buffer_size": 1000000000,
        "modbus_max_register_errors": -1,
        "smp_port": 0,
        "mcp_server_port": 80
      }
    },
    {
      "name": "zero and empty string survive ?? but not ||",
      "input": {
        "raw": {
          "session_manager_stats_interval": 0,
          "install_id": "",
          "config_path": "",
          "signal_colour_none": "",
          "theme_accent_primary": ""
        }
      },
      "expected": {
        "session_manager_stats_interval": 0
      }
    },
    {
      "name": "id formats coerce anything but decimal to hex",
      "input": {
        "raw": {
          "display_frame_id_format": "HEX",
          "save_frame_id_format": "Decimal"
        }
      },
      "expected": {}
    },
    {
      "name": "other enums pass through unchecked",
      "input": {
        "raw": {
          "display_time_format": "bogus",
          "display_timezone": "mars",
          "theme_mode": "neon",
          "default_frame_type": "lin",
          "log_level": "loud"
        }
      },
      "expected": {
        "display_time_format": "bogus",
        "display_timezone": "mars",
        "default_frame_type": "lin",
        "theme_mode": "neon",
        "log_level": "loud"
      }
    },
    {
      "name": "null takes the default",
      "input": {
        "raw": {
          "log_level": null,
          "prevent_idle_sleep": null,
          "default_read_profile": null,
          "default_write_profiles": null
        }
      },
      "expected": {}
    },
    {
      "name": "wrong types pass through",
      "input": {
        "raw": {
          "query_result_limit": "500",
          "prevent_idle_sleep": "yes",
          "language": 7
        }
      },
      "expected": {
        "query_result_limit": "500",
        "prevent_idle_sleep": "yes",
        "language": 7
      }
    },
    {
