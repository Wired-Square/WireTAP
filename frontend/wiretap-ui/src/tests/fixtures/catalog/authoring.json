    {
      "name": "Checksum: endianness only past one byte",
      "input": [
        {
          "name": "CRC",
          "algorithm": "crc8",
          "start_byte": 7,
          "byte_length": 1,
          "endianness": "big",
          "calc_start_byte": 0,
          "calc_end_byte": 7,
          "notes": ""
        },
        {
          "name": "CRC16",
          "algorithm": "crc16_modbus",
          "start_byte": -2,
          "byte_length": 2,
          "endianness": "little",
          "calc_start_byte": 0,
          "calc_end_byte": -2,
          "notes": "Modbus"
        }
      ],
      "expected": [
        {
          "ops": [
            {
              "op": "UpsertArrayItem",
              "array_path": [
                "frame",
                "can",
                "0x100",
                "checksum"
              ],
              "value": {
                "name": "CRC",
                "algorithm": "crc8",
                "start_byte": 7,
                "byte_length": 1,
                "calc_start_byte": 0,
                "calc_end_byte": 7
              },
              "sort_keys": [
                "start_byte",
                "name"
              ]
            }
          ]
        },
        {
          "ops": [
            {
              "op": "UpsertArrayItem",
              "array_path": [
                "frame",
                "serial",
                "0x10",
                "checksum"
              ],
              "value": {
                "name": "CRC16",
                "algorithm": "crc16_modbus",
                "start_byte": -2,
                "byte_length": 2,
                "calc_start_byte": 0,
                "calc_end_byte": -2,
                "endianness": "little",
                "notes": "Modbus"
              },
              "index": 0,
              "sort_keys": [
                "start_byte",
                "name"
              ]
            }
          ]
        },
        {
          "ops": [
            {
              "op": "RemoveArrayItem",
              "array_path": [
                "frame",
                "can",
                "0x100",
                "checksum"
              ],
              "index": 0,
              "remove_if_empty": true
            }
          ]
        }
      ]
    },
