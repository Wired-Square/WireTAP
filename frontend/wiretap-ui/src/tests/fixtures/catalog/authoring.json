        "forms": {
          "meta": {
            "name": "N",
            "version": 4,
            "default_frame": "can"
          },
          "canDefaultEndianness": "big",
          "canDefaultInterval": 100,
          "canDefaultExtended": true,
          "canFrameIdMask": " 0x1FFFFF00 ",
