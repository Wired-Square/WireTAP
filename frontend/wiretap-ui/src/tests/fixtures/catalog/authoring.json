    {
      "name": "Mux case add, rename and delete",
      "input": {
        "muxPath": [
          "frame",
          "can",
          "0x100",
          "mux"
        ]
      },
      "expected": [
        {
          "ops": [
            {
              "op": "SetTable",
              "path": [
                "frame",
                "can",
                "0x100",
                "mux",
                "1"
              ],
              "value": {
                "notes": "first"
              },
              "managed_keys": [
                "notes"
              ],
              "error_if_exists": true
            }
          ],
          "returned": {
            "toml": "[meta]\nname = \"x\"\nversion = 1\n\n[frame.can.\"0x100\"]\nlength = 8\n",
            "didAdd": true
          }
        },
        {
          "ops": [
            {
              "op": "SetTable",
              "path": [
                "frame",
                "can",
                "0x100",
                "mux",
                "2"
              ],
              "value": {},
              "managed_keys": [
                "notes"
              ],
              "error_if_exists": true
            }
          ],
          "returned": {
            "toml": "[meta]\nname = \"x\"\nversion = 1\n\n[frame.can.\"0x100\"]\nlength = 8\n",
            "didAdd": true
          }
        },
        {
          "ops": [
            {
              "op": "RenameKey",
              "parent_path": [
                "frame",
                "can",
                "0x100",
                "mux"
              ],
              "old": "1",
              "new": "0-3",
              "set_value": {},
              "managed_keys": [
                "notes"
              ],
              "error_if_exists": true
            }
          ],
          "returned": {
            "toml": "[meta]\nname = \"x\"\nversion = 1\n\n[frame.can.\"0x100\"]\nlength = 8\n",
            "success": true
          }
        },
        {
          "ops": [
            {
              "op": "DeleteAtPath",
              "path": [
                "frame",
                "can",
                "0x100",
                "mux",
                "2"
              ]
            }
          ]
        }
      ]
    },
