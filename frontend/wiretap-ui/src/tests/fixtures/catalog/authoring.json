{
  "cases": [
    {
      "name": "A new frame is AddFrame; an edit is SetFrame, naming the old key only on a rename",
      "input": {
        "frame": {
          "length": 2,
          "register_type": "input"
        }
      },
      "expected": [
        {
          "ops": [
            {
              "op": "AddFrame",
              "protocol": "modbus",
              "key": "5000",
              "frame": {
                "length": 2,
                "register_type": "input"
              }
            }
          ]
        },
        {
          "ops": [
            {
              "op": "SetFrame",
              "protocol": "modbus",
              "key": "5000",
              "frame": {
                "length": 2,
                "register_type": "input"
              }
            }
          ]
        },
        {
          "ops": [
            {
              "op": "SetFrame",
              "protocol": "modbus",
              "key": "5001",
              "rename_from": "5000",
              "frame": {
                "length": 2,
                "register_type": "input"
              }
            }
          ]
        }
      ]
    },
