{
  "name": "wiretap-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend/wiretap-ui"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend/wiretap-ui",
    "build": "npm run build -w frontend/wiretap-ui",
    "gen:css": "npm run gen:css -w frontend/wiretap-ui",
    "preview": "npm run preview -w frontend/wiretap-ui",
    "test": "npm run test -w frontend/wiretap-ui",
    "test:run": "npm run test:run -w frontend/wiretap-ui",
    "test:watch": "npm run test:watch -w frontend/wiretap-ui",
    "tauri": "tauri",
    "tauri:dev": "bash scripts/tauri-dev.sh",
    "tauri:build": "node scripts/bump-version.js && if [ \"$APPLE_NOTARISE\" = \"true\" ]; then export APPLE_PASSWORD=\"$APPLE_NOTARY_PASSWORD\"; fi && bash scripts/tauri.sh build && bash scripts/macos-bundle-sign.sh",
    "tauri:build:debug": "bash scripts/tauri.sh build --debug && bash scripts/macos-bundle-sign.sh",
    "ios:init": "bash scripts/tauri.sh ios init",
    "ios:dev": "bash scripts/ios-dev.sh",
    "ios:build": "bash scripts/tauri.sh ios build",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:rebuild": "node scripts/release.js rebuild",
    "notarise:build": "APPLE_PASSWORD=\"$APPLE_NOTARY_PASSWORD\" bash scripts/tauri.sh build",
    "notarise:history": "xcrun notarytool history --apple-id \"$APPLE_ID\" --team-id \"$APPLE_TEAM_ID\" --password \"$APPLE_NOTARY_PASSWORD\"",
    "notarise:log": "xcrun notarytool log --apple-id \"$APPLE_ID\" --team-id \"$APPLE_TEAM_ID\" --password \"$APPLE_NOTARY_PASSWORD\"",
    "notarise:info": "xcrun notarytool info --apple-id \"$APPLE_ID\" --team-id \"$APPLE_TEAM_ID\" --password \"$APPLE_NOTARY_PASSWORD\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
